{
  "schemaVersion": 1,
  "instanceName": null,
  "workDir": "/absolute/path/to/projects",
  "debug": true,
  "uiWidgets": true,
  "experimental": {
    "agentTickets": false,
    "forceReadOnlyToolAnnotations": false,
    "forceDestructiveToolAnnotations": false,
    "forceIdempotentToolAnnotations": null,
    "forceOpenWorldToolAnnotations": false,
    "claudeSkills": false
  },
  "apiKey": null,
  "conversationAuthToken": null,
  "port": 3000,
  "projectCloneDir": ".",
  "worktrees": {
    "mode": "auto",
    "root": null,
    "upstreamRefreshMode": "best-effort",
    "autoCleanupEnabled": true,
    "keepCount": 15,
    "allowSetupScript": false
  },
  "tree": {
    "defaultDepth": 3,
    "ignore": [
      "node_modules",
      ".git",
      "dist",
      ".next",
      "__pycache__"
    ]
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": []
  },
  "command": {
    "defaultTimeout": 30000,
    "maxTimeout": 120000
  },
  "exec": {
    "maxSessions": 8,
    "defaultShell": null,
    "idleTimeoutMs": 300000
  },
  "projectDoc": {
    "maxBytes": 32768,
    "fallbackFilenames": [],
    "rootMarkers": [
      ".git"
    ]
  },
  "output": {
    "maxToolOutputTokens": 10000,
    "maxFileLines": 1000,
    "maxFileBytes": 131072,
    "maxEntries": 500,
    "maxTreeNodes": 1000
  },
  "filesystem": {
    "maxConcurrentWorkers": 8,
    "maxPendingRequests": 16,
    "maxScanBytes": 67108864,
    "maxScanEntries": 100000,
    "maxLineBytes": 1048576
  },
  "diff": {
    "maxPatchBytes": 4194304,
    "commandTimeoutMs": 30000
  },
  "toolLogging": {
    "mode": "all",
    "level": "info",
    "maxRequestBytes": 2048,
    "maxResponseBytes": 4096,
    "redactEnv": []
  },
  "audit": {
    "logFile": null,
    "includeCommandPreview": true,
    "commandPreviewMaxBytes": 512,
    "redactEnv": [],
    "enabled": true
  },
  "artifactIngress": {
    "enabled": true,
    "maxFileBytes": 104857600,
    "requestTimeoutMs": 120000,
    "idleTimeoutMs": 30000,
    "maxRedirects": 3,
    "maxConcurrentDownloads": 8,
    "allowedHosts": [
      "*"
    ]
  },
  "artifactEgress": {
    "enabled": false,
    "maxFileBytes": 104857600,
    "snapshotMaxFileBytes": 104857600,
    "maxSnapshotBytes": 5368709120,
    "fallbackToSource": true,
    "maxReferences": 64,
    "referenceTtlMs": 300000
  },
  "memory": {
    "enabled": true,
    "dir": null,
    "maxBytes": 16384
  },
  "agentChat": {
    "enabled": true,
    "port": 3120,
    "maxWaitMs": 55000,
    "offlineTimeoutMinutes": 5,
    "defaultMessageMode": "queue",
    "rolloutReminderInterval": 25,
    "automation": {
      "enabled": true,
      "descriptorPath": "~/.codexify/browser/descriptor.json",
      "connectorName": "",
      "requestBlockList": [
        "^https?://(www\\.)?chatgpt\\.com/.*/rgstr",
        "^https?://(www\\.)?chatgpt\\.com/backend-api/.*/conversations",
        "^https?://(www\\.)?chatgpt\\.com/backend-api/conversations",
        "^https?://(www\\.)?chatgpt\\.com/backend-api/sidebar",
        "^https?://(www\\.)?chatgpt\\.com/backend-api/.*/sidebar"
      ],
      "maxQueuedActions": 64,
      "autoApproveToolCalls": true,
      "automaticRetries": true,
      "retryTimings": {
        "actionDelaysSeconds": [30, 60, 120, 240, 480],
        "chatgptAccessDelaysSeconds": [180, 300, 600, 1200, 1800, 3600],
        "goalRecoveryDelaysSeconds": [60, 120, 240],
        "jitterPercent": 10,
        "approvalResumeGraceSeconds": 180,
        "conversationLoadIntervalSeconds": 180,
        "conversationUnavailableCooldownSeconds": 300,
        "rateLimitCooldownSeconds": 180
      },
      "requestBlockingEnabled": false
    },
    "notifications": {
      "urls": [
        "ntfys://ntfy.example/codexify?image=no"
      ],
      "pythonPath": "python3",
      "timeoutMs": 15000,
      "events": {
        "messages": false,
        "completed": true,
        "inputRequired": true,
        "goalBlocked": true,
        "errors": true,
        "offline": false
      }
    },
    "rolloutEnabled": true,
    "turnRenewal": {
      "enabled": false,
      "limits": [
        {
          "model": "gpt-6-astra",
          "effort": "max",
          "minutes": 55,
          "enabled": true
        },
        {
          "model": "gpt-5.6-sol",
          "effort": "max",
          "minutes": 115,
          "enabled": true
        },
        {
          "model": "gpt-6-sol",
          "effort": "xhigh",
          "minutes": 55,
          "enabled": true
        },
        {
          "model": "gpt-6-sol",
          "effort": "high",
          "minutes": 55,
          "enabled": true
        },
        {
          "model": "gpt-6-sol",
          "effort": "medium",
          "minutes": 55,
          "enabled": true
        },
        {
          "model": "gpt-5.6-sol",
          "effort": "xhigh",
          "minutes": 55,
          "enabled": true
        },
        {
          "model": "gpt-5.6-sol",
          "effort": "high",
          "minutes": 55,
          "enabled": true
        },
        {
          "model": "gpt-5.6-sol",
          "effort": "medium",
          "minutes": 55,
          "enabled": true
        },
        {
          "model": "gpt-5.5-sol",
          "effort": "max",
          "minutes": 55,
          "enabled": true
        },
        {
          "model": "gpt-5.5-sol",
          "effort": "xhigh",
          "minutes": 55,
          "enabled": true
        },
        {
          "model": "gpt-5.5-sol",
          "effort": "high",
          "minutes": 55,
          "enabled": true
        },
        {
          "model": "gpt-5.5-sol",
          "effort": "medium",
          "minutes": 55,
          "enabled": true
        },
        {
          "model": "gpt-6-sol",
          "effort": "low",
          "minutes": 55,
          "enabled": true
        },
        {
          "model": "gpt-5.6-sol",
          "effort": "low",
          "minutes": 55,
          "enabled": true
        },
        {
          "model": "gpt-5.5-sol",
          "effort": "low",
          "minutes": 55,
          "enabled": true
        }
      ]
    },
    "extras": {
      "achievements": true,
      "animations": true,
      "sounds": true,
      "weeklyRecap": true,
      "dailyStreaks": true,
      "personalRecords": true
    }
  },
  "skills": {
    "enabled": true,
    "dirs": null,
    "includePlugins": true
  },
  "codexMcp": {
    "enabled": true,
    "useCli": true,
    "cliPath": null
  },
  "projectCatalog": {
    "codexConfig": {
      "enabled": true,
      "trustedOnly": true
    },
    "entries": [
      {
        "path": "example-project",
        "name": "Example project",
        "aliases": [
          "example"
        ],
        "description": "Optional searchable metadata for this project"
      }
    ]
  },
  "allowedHosts": [],
  "openaiTunnels": [
    {
      "tunnelId": "tunnel_0123456789abcdef0123456789abcdef",
      "apiKeyRef": "env:FIRST_TUNNEL_API_KEY",
      "clientPath": null,
      "organizationId": null
    },
    {
      "tunnelId": "tunnel_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "apiKeyRef": "env:SECOND_TUNNEL_API_KEY",
      "clientPath": null,
      "organizationId": null
    }
  ],
  "mcpServers": {
    "local-example": {
      "command": "npx",
      "args": [
        "-y",
        "example-mcp-server"
      ],
      "env": {
        "EXAMPLE_MODE": "1"
      },
      "cwd": null,
      "disabled": true,
      "type": "stdio",
      "url": null,
      "bearerTokenEnvVar": null,
      "httpHeaders": {},
      "envHttpHeaders": {},
      "startupTimeoutSec": 20,
      "toolTimeoutSec": 60,
      "requestLimits": {
        "maxConcurrentRequests": 4,
        "maxPendingRequests": 16,
        "failureThreshold": 3,
        "recoveryDelayMs": 30000,
        "slowCancellationMs": 60000
      },
      "tools": [
        "example_tool"
      ],
      "disabledTools": [],
      "mode": "direct"
    },
    "remote-example": {
      "command": null,
      "args": [],
      "env": {},
      "cwd": null,
      "disabled": true,
      "type": "streamable-http",
      "url": "https://mcp.example.com/mcp",
      "bearerTokenEnvVar": "EXAMPLE_REMOTE_MCP_TOKEN",
      "httpHeaders": {
        "X-Client": "codexify-example"
      },
      "envHttpHeaders": {
        "X-Tenant": "EXAMPLE_REMOTE_MCP_TENANT"
      },
      "startupTimeoutSec": 20,
      "toolTimeoutSec": 60,
      "requestLimits": {
        "maxConcurrentRequests": 4,
        "maxPendingRequests": 16,
        "failureThreshold": 3,
        "recoveryDelayMs": 30000,
        "slowCancellationMs": 60000
      },
      "tools": null,
      "disabledTools": [],
      "mode": "catalog"
    }
  }
}
